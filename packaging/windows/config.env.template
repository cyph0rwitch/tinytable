# TinyTable settings. One KEY=VALUE per line; restart TinyTable after editing.
# Variables already set in the environment take precedence over this file.
# History is stored in %LOCALAPPDATA%\TinyTable\data\tinytable.db unless
# TINYTABLE_DB is set; logs are in %LOCALAPPDATA%\TinyTable\logs.

# Loopback only. Add an authentication boundary before exposing it further.
TINYTABLE_HOST=127.0.0.1
TINYTABLE_PORT=8000

# Standalone local unit: local model only, no remote companion adapters.
TINYTABLE_STANDALONE=1
TINYTABLE_REPLIKA_OUTBOUND_ENABLED=0
TINYTABLE_MULTI_AGENT_ENABLED=0
TINYTABLE_AGENT_FOLLOWUP_ENABLED=0

# Local model through Ollama's OpenAI-compatible endpoint.
TINYTABLE_PROVIDER_BASE_URL=http://127.0.0.1:11434/v1
TINYTABLE_PROVIDER_MODEL=llama3.2
TINYTABLE_PROVIDER_TIMEOUT=120

# Optional sidecars; install the matching component first.
TINYTABLE_START_KINDROID=0
TINYTABLE_START_MATRIX=0
