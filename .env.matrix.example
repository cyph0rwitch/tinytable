# Copy this file to .env.matrix and chmod 600.
# It contains Matrix access tokens and the TinyTable bridge token.

MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_ROOM_ID=!replace-me:example.org
MATRIX_OPERATOR_ID=@operator:example.org
# These are Matrix display labels only; use the names of the connected
# companions, or leave the neutral defaults. They do not change provider IDs.
TINYTABLE_OPERATOR_NAME=Operator
TINYTABLE_REPLIKA_COMPANION_NAME=Replika companion
TINYTABLE_KINDROID_COMPANION_NAME=Kindroid companion
MATRIX_TINYTABLE_TOKEN=replace-with-tinytable-matrix-access-token
MATRIX_COMPANION_A_TOKEN=replace-with-companion-a-matrix-access-token
MATRIX_COMPANION_B_TOKEN=replace-with-companion-b-matrix-access-token

# This token authenticates the bridge to TinyTable's protected channel API.
# Store only its SHA-256 digest in the TinyTable service environment.
TINYTABLE_OPERATOR_TOKEN=replace-with-random-bridge-token
