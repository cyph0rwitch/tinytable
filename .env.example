TINYTABLE_DB=/data/tinytable.db

# Automatic provider turns are disabled by default. Direct/manual Replika and
# Kindroid companion routes remain available.

# Display names and pronouns for each seat (IDs are operator, replika-companion,
# kindroid-companion, kindroid-companion-2, local-model). Unset names show the role.
# TINYTABLE_OPERATOR_NAME=
# TINYTABLE_OPERATOR_PRONOUNS=they/them
# TINYTABLE_REPLIKA_COMPANION_NAME=
# TINYTABLE_REPLIKA_COMPANION_PRONOUNS=they/them
# TINYTABLE_KINDROID_COMPANION_NAME=
# TINYTABLE_KINDROID_COMPANION_PRONOUNS=they/them
# TINYTABLE_LOCAL_MODEL_NAME=
TINYTABLE_MULTI_AGENT_ENABLED=0
# Automatic provider follow-up is disabled by default.
TINYTABLE_AGENT_FOLLOWUP_ENABLED=0
TINYTABLE_REPLIKA_OUTBOUND_ENABLED=0

# Replika read-only receiver. Copy exact values from an authorized browser
# session; the client does not derive or invent auth, IDs, tokens, or cookies.
# Do not commit a real .env file or paste live credentials into source code.
REPLIKA_WS_URL=wss://ws.replika.ai/v17
REPLIKA_WS_HEADERS_JSON={}
REPLIKA_CHAT_ID=
REPLIKA_CUSTOMER_ID=
REPLIKA_BOT_ID=
REPLIKA_SESSION_TOKEN=
REPLIKA_BOOTSTRAP_FILE=replika_bootstrap_current.md

# Optional: exact, browser-observed client-to-server initialization/context
# frames, in order, as one JSON array. Do not include any event_name="message"
# frame. The provider rejects customer-message frames and never creates them.
REPLIKA_BOOTSTRAP_FRAMES_JSON='[]'

# Optional Hermes CLI agents for the terminal room (tinytable-cli room ...), as JSON:
# TINYTABLE_CLI_AGENTS=[{"id": "helper", "name": "Helper", "transport": "hermes_local", "profile": "default"}]
